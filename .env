### Local environment example for Git Account Manager
# Copy this file to ".env" and fill in the missing secrets before running the app locally.

# GitHub OAuth / App settings
# App ID (provided)
GITHUB_APP_ID=2326009

# Client ID (public)
GITHUB_CLIENT_ID=Iv23liXb7xlnhBvdHIMq

# Client Secret - KEEP THIS SECRET. Fill this from your GitHub OAuth App settings.
GITHUB_CLIENT_SECRET=93ac2926b22e48d21ee2d5e2c29bd0819927428c


GITLAB_APP_ID=21c339fe33a9e28695f863a5fe4a7d2b4c83c56f3a473854d5d5ba99eabc4ef4
GITLAB_CLIENT_SECRET=gloas-72a86f6b19333aabd4a842e68151b389896260e138ac11d3040fc83ba847beef

